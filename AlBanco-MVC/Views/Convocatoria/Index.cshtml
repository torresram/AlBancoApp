@model IEnumerable<AlBanco_MVC.Models.Convocatoria>

@{
    ViewData["Title"] = "Encontrar Partidos";
}
<div class="container py-5 flex-grow-1">
    <!-- Header Section -->
    <div class="mb-5 text-center text-md-start">
        <h1 class="fw-bold mb-2">Invitaciones a Partidos</h1>
        <p class="text-secondary mb-0">Mirá quién busca jugadores y sumate al equipo.</p>
    </div>
    <!-- Requests List (Bootstrap Grid) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- Card 1 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="position-relative view-height-200">
                    <img alt="Football pitch" class="w-100 h-100 object-fit-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_eBnPZL9HjzixO1dVoyc5K17Y1rz0GAvTG6fSzgNrNGO17JcxMDOeKcisRIaFNAyCJ6eFt2h3XU5ah9SlzVY1w5M2AWRpJMjkb7t5zQxlQKHupv4BFaUsxXxHkXZIrIBu4ILOq4C4KZ445s1lEteEr1Y-TH9OphUIJphqkLpxJBhunnigH7Qi0-TpmKe7pR_R4To3W9vKFJDYNPNKHKffyIc5_OvEgIPlI-KdYBLgZIv_2uKMHcIZT81KpvmilaSLu-UkkZBv2Q" />
                    <div class="position-absolute top-0 start-0 m-3">
                        <span class="badge bg-danger text-uppercase p-2">Faltan jugadores</span>
                    </div>
                </div>
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title fw-bold mb-0">Camp Nou de Banfield</h5>
                        <span class="badge bg-secondary fs-6">$1.200</span>
                    </div>
                    <div class="row g-2 text-secondary mb-4">
                        <div class="col-6 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">calendar_today</span>
                            <span class="small fw-medium">Hoy, 24 Oct</span>
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">schedule</span>
                            <span class="small fw-medium">21:00 hs</span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1 text-letter-spaced">Observaciones</p>   
                        <p class="card-text fst-italic text-secondary">"Traer pechera blanca si tenés. El arquero ya está confirmado."</p>
                    </div>
                    <div class="mt-auto d-flex gap-2">
                        <button class="btn btn-success flex-grow-1 fw-bold d-flex align-items-center justify-content-center gap-1 py-2">
                            <span class="material-symbols-outlined fs-5">check_circle</span>
                            VOY
                        </button>
                        <button class="btn btn-outline-secondary fw-bold d-flex align-items-center justify-content-center gap-1 py-2 px-3">
                            <span class="material-symbols-outlined fs-5">cancel</span>
                            NO PUEDO
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="position-relative view-height-200">
                    <img alt="Indoor Arena" class="w-100 h-100 object-fit-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuApbr_oKtbCrsMiIRFU_muLjOmqT0wkbb_b8-dNxmlhwdf-bUAQ4jfw9D5dF5Q7Pdhx2yqa0LxsupB-F7zVPh65Ndsh5i0G9gYypdb1Qp8YvtEBFFfDm3Fwaw-9v0XqWMKcuPAQdcEQu2k44oS_Az5_Q3Tpu2FN0fz4KU3mGWxrcpjrCnTd2CR1SJXpW2MBCSKpbCPuuWmzpR8JdQHe01cnKoLk7qSDhASX66ms-Que9ZtpBr0z1Tdz7ZgEkxnv7fdhhJS7Lhw7wQ" />
                    <div class="position-absolute top-0 start-0 m-3">
                        <span class="badge bg-danger text-uppercase p-2">Faltan jugadores</span>
                    </div>
                </div>
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title fw-bold mb-0">Complejo El Diez</h5>
                        <span class="badge bg-secondary fs-6">$1.500</span>
                    </div>
                    <div class="row g-2 text-secondary mb-4">
                        <div class="col-6 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">calendar_today</span>
                            <span class="small fw-medium">Mañana, 25 Oct</span>
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">schedule</span>
                            <span class="small fw-medium">19:30 hs</span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1 text-letter-spaced">Observaciones</p>
                        <p class="card-text fst-italic text-secondary">"Falta 1 delantero picante. Nivel intermedio. Vení con ganas de correr."</p>
                    </div>
                    <div class="mt-auto d-flex gap-2">
                        <button class="btn btn-success flex-grow-1 fw-bold d-flex align-items-center justify-content-center gap-1 py-2">
                            <span class="material-symbols-outlined fs-5">check_circle</span>
                            VOY
                        </button>
                        <button class="btn btn-outline-secondary fw-bold d-flex align-items-center justify-content-center gap-1 py-2 px-3">
                            <span class="material-symbols-outlined fs-5">cancel</span>
                            NO PUEDO
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Card 3 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="position-relative view-height-200">
                    <img alt="Urban Pitch" class="w-100 h-100 object-fit-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCiVcTHwtH31xmAdK4mresbDaBLvtsh_kRPo_aPzFDp2FnoizqABCAJatpdCKQ48EUen4_3Nwjrq1bzXW5rPwSVBvzZ6xnm29uHjuoFcRUDTvAzJrpfIfvsPEte0HH0KcnFLuJK-hfDP4nPYRSG53dgSQwO2kL4CULHRfmqPxvrIy6yKDszPTW3LCwaFDnZNejzeHsmE0h8MvKnMM0LBoqnzL2MJisiR4Kxa0WIVeH-Hvs-PfM5qpejZs8eyzFOGcSHS335gwdndg" />
                    <div class="position-absolute top-0 start-0 m-3">
                        <span class="badge bg-danger text-uppercase p-2">Faltan jugadores</span>
                    </div>
                </div>
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title fw-bold mb-0">Predio La Masía</h5>
                        <span class="badge bg-secondary fs-6">$1.100</span>
                    </div>
                    <div class="row g-2 text-secondary mb-4">
                        <div class="col-6 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">calendar_today</span>
                            <span class="small fw-medium">Sáb, 26 Oct</span>
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined fs-5">schedule</span>
                            <span class="small fw-medium">11:00 hs</span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1 text-letter-spaced">Observaciones</p>
                        <p class="card-text fst-italic text-secondary">"Partido 7v7. Se paga en efectivo en el lugar. Venir 15 min antes."</p>
                    </div>
                    <div class="mt-auto d-flex gap-2">
                        <button class="btn btn-success flex-grow-1 fw-bold d-flex align-items-center justify-content-center gap-1 py-2">
                            <span class="material-symbols-outlined fs-5">check_circle</span>
                            VOY
                        </button>
                        <button class="btn btn-outline-secondary fw-bold d-flex align-items-center justify-content-center gap-1 py-2 px-3">
                            <span class="material-symbols-outlined fs-5">cancel</span>
                            NO PUEDO
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>