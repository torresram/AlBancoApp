@{
    ViewData["Title"] = "Home Page";
}

<section class="position-relative vh-100 min-vh-600 d-flex align-items-center justify-content-center text-center px-3 px-md-4 hero-gradient">
    <div class="z-1 d-flex flex-column align-items-center gap-4" style="max-width: 800px;">
        <h1 class="text-white fw-bold text-uppercase display-5 display-md-3" style="letter-spacing: -0.02em;">
            No importa perder. No importa ganar. Importa JUGAR.
        </h1>
        <p class="text-white fs-5 fs-md-4 opacity-75 mb-0" style="max-width: 600px;">
            La forma más rápida de encontrar el jugador que falta.
        </p>
        <div class="d-flex flex-column flex-md-row gap-3 mt-4 w-100 w-md-auto justify-content-center">
            <button class="btn btn-success bg-primary-container border-0 px-5 py-3 fw-bold fs-5 shadow-lg">
                Sumate a AlBanco
            </button>
            <a asp-controller="Convocatoria" asp-action="Index" class="btn btn-outline-light px-5 py-3 fw-bold fs-5 border-2"> 
                Me faltan jugadores
            </a>
        </div>
    </div>
    <!-- Atmospheric scroll indicator -->
    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 animate-bounce-custom d-flex flex-column align-items-center">
        <span class="text-white-50 small mb-1">Desliza</span>
        <span class="material-symbols-outlined text-white-50">expand_more</span>
    </div>
</section>
<!-- Stats / Trust Bar (Bento-lite) -->
<section class="bg-surface-container py-5 px-3 px-md-4">
    <div class="container-xl">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column align-items-center p-3 bg-surface rounded-3 border border-outline-variant">
                    <span class="text-primary-custom fw-black fs-2">150+</span>
                    <span class="text-secondary-custom small text-uppercase" style="letter-spacing: 0.1em;">Canchas</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column align-items-center p-3 bg-surface rounded-3 border border-outline-variant">
                    <span class="text-primary-custom fw-black fs-2">5k+</span>
                    <span class="text-secondary-custom small text-uppercase" style="letter-spacing: 0.1em;">Jugadores</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column align-items-center p-3 bg-surface rounded-3 border border-outline-variant">
                    <span class="text-primary-custom fw-black fs-2">2k+</span>
                    <span class="text-secondary-custom small text-uppercase" style="letter-spacing: 0.1em;">Partidos</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column align-items-center p-3 bg-surface rounded-3 border border-outline-variant">
                    <span class="text-primary-custom fw-black fs-2">24/7</span>
                    <span class="text-secondary-custom small text-uppercase" style="letter-spacing: 0.1em;">Alertas</span>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- 'Cómo funciona' Section -->
<section class="py-5 px-3 px-md-4 bg-surface">
    <div class="container-xl my-4">
        <div class="mb-5 text-center text-md-start">
            <h2 class="fs-2 fw-black text-on-surface text-uppercase mb-2">Cómo funciona</h2>
            <div class="bg-primary-container rounded-pill mx-auto mx-md-0" style="height: 6px; width: 96px;"></div>
        </div>
        <div class="row g-4">
            <!-- Step 1 -->
            <div class="col-12 col-md-4">
                <div class="bento-card p-4 bg-surface border border-outline-variant rounded-3 d-flex flex-column gap-3 h-100">
                    <div class="bento-icon-wrapper rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; background-color: rgba(25, 135, 84, 0.1);">
                        <span class="material-symbols-outlined text-primary-custom fs-1" data-icon="qr_code_2">qr_code_2</span>
                    </div>
                    <h3 class="fs-4 fw-bold text-on-surface mb-0">Escaneá</h3>
                    <p class="text-secondary-custom mb-0">
                        Escaneá el QR de tu cancha favorita para registrarte al sistema de convocatorias automáticas.
                    </p>
                    <div class="mt-auto pt-3 d-flex align-items-center text-primary-custom fw-bold small text-decoration-none">
                        Ver canchas amigas <span class="material-symbols-outlined ms-1 fs-6">arrow_forward</span>
                    </div>
                </div>
            </div>
            <!-- Step 2 -->
            <div class="col-12 col-md-4">
                <div class="bento-card p-4 bg-surface border border-outline-variant rounded-3 d-flex flex-column gap-3 h-100">
                    <div class="bento-icon-wrapper rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; background-color: rgba(25, 135, 84, 0.1);">
                        <span class="material-symbols-outlined text-primary-custom fs-1" data-icon="group">group</span>
                    </div>
                    <h3 class="fs-4 fw-bold text-on-surface mb-0">Sumate</h3>
                    <p class="text-secondary-custom mb-0">
                        Unite a la comunidad de jugadores locales. Completá tu perfil indicando tu posición y nivel.
                    </p>
                    <div class="mt-auto pt-3 d-flex align-items-center text-primary-custom fw-bold small text-decoration-none">
                        Crear perfil <span class="material-symbols-outlined ms-1 fs-6">arrow_forward</span>
                    </div>
                </div>
            </div>
            <!-- Step 3 -->
            <div class="col-12 col-md-4">
                <div class="bento-card p-4 bg-surface border border-outline-variant rounded-3 d-flex flex-column gap-3 h-100">
                    <div class="bento-icon-wrapper rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; background-color: rgba(25, 135, 84, 0.1);">
                        <span class="material-symbols-outlined text-primary-custom fs-1" data-icon="sports">sports</span>
                    </div>
                    <h3 class="fs-4 fw-bold text-on-surface mb-0">Jugá</h3>
                    <p class="text-secondary-custom mb-0">
                        Recibí alertas instantáneas por WhatsApp cuando falte un jugador en tu zona y confirmá tu lugar.
                    </p>
                    <div class="mt-auto pt-3 d-flex align-items-center text-primary-custom fw-bold small text-decoration-none">
                        Configurar alertas <span class="material-symbols-outlined ms-1 fs-6">arrow_forward</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- CTA Section with Mock UI -->
<section class="py-5 px-3 px-md-4 bg-on-surface overflow-hidden">
    <div class="container-xl my-4">
        <div class="row align-items-center gy-5">
            <div class="col-12 col-lg-6 text-white text-center text-lg-start">
                <h2 class="display-5 fw-black text-uppercase mb-3">¿Te falta uno?</h2>
                <p class="fs-5 text-white-50 mb-4 mx-auto mx-lg-0" style="max-width: 500px;">
                    No canceles el partido. Encontrá al reemplazo perfecto en menos de 5 minutos entre nuestra red de jugadores validados.
                </p>
                <button class="btn btn-success bg-primary-container border-0 px-5 py-3 rounded-3 fw-black fs-5 text-uppercase w-100 w-md-auto">
                    ⚽ ME FALTA UNO
                </button>
            </div>
            <div class="col-12 col-lg-6 position-relative">
                <!-- Phone Mockup -->
                <div class="mx-auto bg-dark rounded-5 shadow-lg position-relative" style="width: 250px; height: 500px; border: 14px solid #343a40;">
                    <div class="rounded-4 overflow-hidden w-100 h-100 bg-white d-flex flex-column">
                        <div class="bg-primary-container p-3 text-white">
                            <p class="small mb-0 opacity-75">Nueva Notificación</p>
                            <p class="fw-bold mb-0">¡FALTA UNO!</p>
                        </div>
                        <div class="p-3 d-flex flex-column gap-3">
                            <div class="bg-surface-container p-2 rounded-3 d-flex gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: rgba(0, 108, 64, 0.2);">
                                    <span class="material-symbols-outlined text-primary-custom">person</span>
                                </div>
                                <div>
                                    <p class="fw-bold small mb-0">Panchi F5</p>
                                    <p class="text-secondary-custom mb-0" style="font-size: 10px;">Hoy 21:00hs • Cancha 3</p>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <div class="bg-outline-variant rounded" style="height: 8px; width: 75%;"></div>
                                <div class="bg-outline-variant rounded" style="height: 8px; width: 50%;"></div>
                            </div>
                            <button class="btn btn-success bg-primary-custom border-0 w-100 rounded-pill small fw-bold py-2 mt-2">ME SUMO</button>
                        </div>
                    </div>
                </div>
                <!-- Decorative element -->
                <div class="position-absolute rounded-circle" style="z-index: -1; bottom: -40px; right: -40px; width: 256px; height: 256px; background-color: rgba(0, 108, 64, 0.2); filter: blur(40px);"></div>
            </div>
        </div>
    </div>
</section>
