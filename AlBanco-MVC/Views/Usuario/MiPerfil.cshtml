@model Usuario

@{
    ViewData["Title"] = "Mi Perfil";
}
<div class="container mt-2">
    <section class="mb-4">
        <h1 class="fw-bold fs-2 text-dark mb-1">Hola @Model.Nombre! 👋</h1>
        <p class="text-secondary fs-6 mb-0">¿Listo para el partido de hoy?</p>
    </section>
    <!-- Main CTA Area -->
    <section class="mb-4">
        <a asp-controller="Convocatoria" asp-action="FaltaUno" class="btn btn-success w-100 py-3 rounded-3 cta-shadow d-flex align-items-center justify-content-center gap-2 fw-bold fs-5">
            <span class="fs-4">⚽</span>
            <span>ME FALTA UNO</span>
        </a>
    </section>
    <div class="row g-4">
        <!-- Main Card: Mi cancha -->
        <div class="col-md-6">
            <div class="card h-100 border rounded-4 overflow-hidden">
                <div class="position-relative overflow-hidden view-height-200">
                    <img alt="Football Field" class="w-100 h-100 object-fit-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBH7yKn-_7OXg5qtJ8nYrNm7Qf8BOM-aePuVIK15SIq7Is5nNfsSF8Zt4paqjjQBwEcOMGopkGCNq1SJTxuUUoO0hGPyOsm7Ia_GJHybEy_VzXcJ7-5ATBfvzwqa0SUgT2EbzN73csFNalVijYLH-vntVXJC9-g1fTesqpaTlGuYQA0Vi33kZD6wPF2W68taB0pmxjuglj5QRlpz1MfQ0zSgcYtJRg-CMCyetmxtKJci-B8xXy_AQ4ZbND_KG-MvAinuEIncINSIg" />
                    <div class="position-absolute top-0 end-0 p-3">
                        <span class="badge bg-success rounded-pill d-flex align-items-center gap-1 shadow-sm px-3 py-2">
                            <span class="material-symbols-outlined view-icon-small">verified</span>
                            Comunidad activa
                        </span>
                    </div>
                </div>
                <div class="card-body d-flex flex-column p-4">
                    <h6 class="text-success text-uppercase fw-semibold mb-2 view-label">Mi cancha</h6>
                    <h5 class="card-title fw-bold fs-4 text-dark mb-3">@Model.Cancha.Nombre</h5>
                    <div class="d-flex align-items-start gap-2 text-secondary mb-4">
                        <span class="material-symbols-outlined fs-5 mt-1">location_on</span>
                        <div>
                            <p class="mb-0 fw-medium">@Model.Cancha.Direccion</p>
                            <p class="mb-0 small">@Model.Cancha.Zona.Nombre</p>
                        </div>
                    </div>
                    <button class="btn btn-outline-success mt-auto py-2 fw-semibold w-100">Ver detalles de la sede</button>
                </div>
            </div>
        </div>
        <!-- Secondary Card: Alerts & Status -->
        <div class="col-md-6 d-flex flex-column gap-4">
            <div class="card border rounded-4 p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center text-success view-alert-icon">
                            <span class="material-symbols-outlined">notifications_active</span>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark fs-5">Recibir alertas</h6>
                            <p class="text-secondary small mb-0">Notificarme sobre nuevos cupos</p>
                        </div>
                    </div>
                    <div class="form-check form-switch fs-4 mb-0">
                        <input checked="" class="form-check-input bg-success border-success" id="alertsSwitch" role="switch" type="checkbox" />
                    </div>
                </div>
                <hr class="text-secondary my-2" />
                <div class="d-flex align-items-center gap-2 mt-2">
                    <span class="bg-success rounded-circle status-dot"></span>
                    <p class="mb-0 fw-medium text-dark" id="statusText">Disponible para recibir convocatorias</p>
                </div>
            </div>
            <!-- Bento-style Stats -->
            <div class="row g-3 flex-grow-1">
                <div class="col-6">
                    <div class="card bg-primary-fixed border-0 h-100 rounded-4 p-3 d-flex flex-column justify-content-between">
                        <span class="material-symbols-outlined fs-2">sports_soccer</span>
                        <div class="mt-4">
                            <h2 class="display-5 fw-bold mb-0">12</h2>
                            <p class="small fw-semibold mb-0">Partidos jugados</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-secondary-container border-0 h-100 rounded-4 p-3 d-flex flex-column justify-content-between">
                        <span class="material-symbols-outlined fs-2">military_tech</span>
                        <div class="mt-4">
                            <h2 class="display-5 fw-bold mb-0">4.8</h2>
                            <p class="small fw-semibold mb-0">Calificación MVP</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Matches Preview -->
    <section class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold fs-4 text-dark mb-0">Próximos partidos</h3>
            <a class="text-success text-decoration-none fw-semibold" href="#">Ver todos</a>
        </div>
        <div class="card border-0 bg-light rounded-4 p-3 cursor-pointer">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white rounded-3 px-3 py-2 text-center border">
                        <p class="small text-secondary fw-semibold mb-0 text-uppercase view-label-small">Hoy</p>
                        <p class="fw-bold fs-5 mb-0 text-dark">20:00</p>
                    </div>
                    <div>
                        <p class="fw-bold text-dark mb-0">Fútbol 5 - Los Galácticos</p>
                        <p class="small text-secondary mb-0">Cancha 3 • 2 cupos libres</p>
                    </div>
                </div>
                <span class="material-symbols-outlined text-secondary">chevron_right</span>
            </div>
        </div>
    </section>
</div>
<script>
    const switchInput = document.getElementById('alertsSwitch');
    const statusText = document.getElementById('statusText');
    switchInput.addEventListener('change', function() {
        if(this.checked) {
            statusText.innerText = "Disponible para recibir convocatorias";
            statusText.classList.remove('text-secondary');
            statusText.classList.add('text-dark');
        } else {
            statusText.innerText = "Modo invisible activo";
            statusText.classList.remove('text-dark');
            statusText.classList.add('text-secondary');
        }
    });
</script>