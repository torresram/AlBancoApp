<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlBancoApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlBanco_MVC.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        :root {
        --primary: #006c40;
        --primary-container: #198754;
        --on-primary-container: #ffffff;
        --surface: #f8f9fa;
        --on-surface: #191c1d;
        --secondary: #5d5f5f;
        --background: #f8f9fa;
        --surface-container: #edeeef;
        --outline-variant: #bdcabe;
        --on-background: #191c1d;
        }

        body {
        font-family: 'Inter', sans-serif;
        scroll-behavior: smooth;
        background-color: var(--background);
        color: var(--on-surface);
        }

        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .hero-gradient {
        background: linear-gradient(rgba(0, 108, 64, 0.85), rgba(25, 28, 29, 0.9)), url('image-hero-football');
        background-size: cover;
        background-position: center;
        }

        /* Custom Utility Classes mapped from Tailwind config */
        .text-primary-custom {
        color: var(--primary) !important;
        }

        .bg-primary-custom {
        background-color: var(--primary) !important;
        }

        .bg-primary-container {
        background-color: var(--primary-container) !important;
        }

        .text-on-primary-container {
        color: var(--on-primary-container) !important;
        }

        .bg-surface {
        background-color: var(--surface) !important;
        }

        .text-on-surface {
        color: var(--on-surface) !important;
        }

        .text-secondary-custom {
        color: var(--secondary) !important;
        }

        .bg-surface-container {
        background-color: var(--surface-container) !important;
        }

        .border-outline-variant {
        border-color: var(--outline-variant) !important;
        }

        .bg-on-surface {
        background-color: var(--on-surface) !important;
        }

        .fw-black {
        font-weight: 900 !important;
        }

        .min-vh-600 {
        min-height: 600px;
        }

        .z-50 {
        z-index: 50;
        }

        .bento-card {
        transition: all 0.3s ease;
        }

        .bento-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary) !important;
        box-shadow: 0 10px 15px -3px rgba(0, 108, 64, 0.1);
        }

        .bento-icon-wrapper {
        transition: transform 0.3s ease;
        }

        .bento-card:hover .bento-icon-wrapper {
        transform: scale(1.1);
        }

        /* keyframes bounce-custom {
        0%, 100% {
        transform: translateY(0);
        } */

        50% {
        transform: translateY(-25%);
        }

        }

        .animate-bounce-custom {
        animation: bounce-custom 1s infinite;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top w-100 z-50 d-flex justify-content-between align-items-center px-3 px-md-4 bg-surface border-bottom border-outline-variant" style="height: 64px;">
        <div class="fs-5 fw-black text-primary-custom">⚽ ALBANCO</div>
        <nav class="d-none d-md-flex align-items-center gap-4">
            <a class="text-secondary-custom fw-medium border-2 text-decoration-none small" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a class="text-secondary-custom fw-medium text-decoration-none small" asp-area="" asp-controller="" asp-action="">Encontrar Partidos</a>
            <a class="text-secondary-custom fw-medium text-decoration-none small" asp-area="" asp-controller="" asp-action="">Mis Partidos</a>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <a class="d-none d-lg-block btn btn-success bg-primary-container border-0 fw-bold small px-3 py-2" asp-controller="Convocatoria" asp-action="Index">ME FALTA UNO</a>
            <a class="btn btn-link text-secondary-custom text-decoration-none fw-medium small p-0"asp-controller="Usuario" asp-action="Index">Mi Perfil</a>
        </div>
        @* <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AlBanco</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Mis Partidos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Partidos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav> *@
    </header>
    <div>
        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AlBanco_MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
