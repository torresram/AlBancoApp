<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlBancoApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/AlBanco_MVC.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top w-100 z-50 d-flex justify-content-between align-items-center px-3 px-md-4 bg-surface border-bottom border-outline-variant view-header">
        <a class="hover-glow-link text-decoration-none" asp-action="Index" asp-controller="Home"><div class="fs-5 fw-black text-primary-custom">⚽ ALBANCO</div></a>
        <nav class="d-none d-md-flex align-items-center gap-4">
            <a class="text-secondary-custom fw-medium border-2 text-decoration-none small hover-glow-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <a class="text-secondary-custom fw-medium text-decoration-none small hover-glow-link" asp-area="" asp-controller="Convocatoria" asp-action="Index">Encontrar Partidos</a>
            <a class="text-secondary-custom fw-medium text-decoration-none small hover-glow-link" asp-area="" asp-controller="Convocatoria" asp-action="MisPartidos">Mis Partidos</a>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <a class="d-none d-lg-block btn btn-success bg-primary-container border-0 fw-bold small px-3 py-2" asp-controller="Convocatoria" asp-action="FaltaUno">ME FALTA UNO</a>
            <a class="btn btn-link text-secondary-custom text-decoration-none fw-medium small p-0"asp-controller="Usuario" asp-action="MiPerfil">Mi Perfil</a>
        </div>
        @* <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AlBanco</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Mis Partidos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Partidos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav> *@
    </header>
    <div>
        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AlBancoApp - No te quedes sin jugar
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
